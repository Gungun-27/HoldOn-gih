# HoldOn Environment Variables
# Copy this to .env (do NOT commit .env)

# Server Configuration
PORT=3001
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# LLM Detection (Groq)
# If empty or absent, HoldOn automatically runs with rule-based fallback ('degraded: true')
GROQ_API_KEY=

# Supabase (Phase P1)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email SMTP (Phase P1)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
